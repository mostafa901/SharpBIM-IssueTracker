    <Metadata>
        <Identity Id="SharpBIM.IssueTracker" Version="0.843.0.0" Language="en-US" Publisher="SharpBIM" />
        <DisplayName>Issue Tracker</DisplayName>
        <Description xml:space="preserve">Issue Tracker helps to visualize &amp; manage Git-hub issues in Visual Studio, offering an intuitive interface to track, view details, &amp; take action easily.</Description>
        <MoreInfo>https://github.com/mostafa901/SharpBIM.IssueTracker</MoreInfo>
        <ReleaseNotes>https://github.com/mostafa901/SharpBIM-IssueTracker/releases/tag/0.825</ReleaseNotes>
        <Icon>IssueTracker_128x128.png</Icon>
        <PreviewImage>IssueTracker_128x128.png</PreviewImage>
        <Tags>issue, Tracker, Github Issues, tickets</Tags>
    </Metadata>
    <Installation>
   
        <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,)">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
    </Installation>
