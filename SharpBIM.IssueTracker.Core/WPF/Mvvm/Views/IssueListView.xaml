<uc:SharpBIMUserControl x:Class="SharpBIM.IssueTracker.Core.WPF.Mvvm.Views.IssueListView"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:Conv="clr-namespace:SharpBIM.WPF.Helpers.Converters;assembly=SharpBIM"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:hl="clr-namespace:SharpBIM.WPF.Utilities;assembly=SharpBIM"
                        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:mv="clr-namespace:SharpBIM.IssueTracker.Core.WPF.Mvvm.ViewModels"
                        xmlns:st="clr-namespace:SharpBIM.IssueTracker.Core.Enums;assembly=SharpBIM.IssueTracker.Core"
                        xmlns:uc="clr-namespace:SharpBIM.WPF.Controls.UserControls;assembly=SharpBIM"
                        xmlns:ui="clr-namespace:SharpBIM.WPF.Controls;assembly=SharpBIM"
                        Margin="5"
                        d:DataContext="{d:DesignInstance Type={x:Type mv:IssueListViewModel}}"
                        d:DesignHeight="450"
                        d:DesignWidth="800"
                        mc:Ignorable="d">
    <Grid>
        <Grid.Resources>
            <hl:SharedResourceDictionary>

                <hl:SharedResourceDictionary.MergedDictionaries>
                    <hl:SharedResourceDictionary SamoDesign="True"
                                                 Source="/SharpBIM;component/WPF/AllControls.xaml" />

                    <hl:SharedResourceDictionary SamoDesign="True"
                                                 Source="/SharpBIM.IssueTracker.Core;component/WPF/Mvvm/Views/DataTemplates.xaml" />
                </hl:SharedResourceDictionary.MergedDictionaries>

            </hl:SharedResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid IsEnabled="{Binding LoggedIn}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>


                <ui:UiComboBox Grid.Column="1"
                               Height="35"
                               MinWidth="100"
                               HorizontalAlignment="Stretch"
                               DisplayMemberPath="name"
                               IsEditable="True"
                               ItemsSource="{Binding RepoModels}"
                               SelectedItem="{Binding SelectedRepo}"
                               SelectionChanged="UiComboBox_SelectionChanged" />
                <ui:UIButton Grid.Column="2"
                             Width="auto"
                             Margin="0"
                             Command="{Binding ReloadReposCommand}"
                             GlyphSize="25"
                             ShowText="False"
                             Style="{StaticResource IconButtonStyle}" />

            </Grid>

            <ui:UIButton Grid.Column="2"
                         Margin="5,0,0,0"
                         Command="{Binding LoadCurrentProjectCommand}"
                         GlyphRotation="90"
                         IsEnabled="{Binding LoggedIn}"
                         ShowText="False" />

            <ui:TaggedTextBox Grid.Column="3"
                              Margin="0,0,0,0"
                              HorizontalAlignment="Stretch"
                              PlaceHolder="Repo Owner name"
                              Text="{Binding RepoOwner}"
                              TextAlignment="Right"
                              UpdateOnEnter="True"
                              Visibility="Collapsed" />

            <ui:SearchTextBox Grid.Column="4"
                              Width="auto"
                              Margin="0,0,0,0"
                              HorizontalAlignment="Stretch"
                              PlaceHolder="Search within the current page"
                              Text="{Binding TextToFilter,
                                             Delay=600,
                                             UpdateSourceTrigger=PropertyChanged}"
                              UpdateOnEnter="true" />
        </Grid>
        <Separator Grid.Row="1"
                   Margin="0,5" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel MinWidth="30">
                <ui:UIButton Grid.Column="0"
                             Width="30"
                             Margin="0"
                             Command="{Binding VisitRepoCommand}"
                             GlyphRotation="90"
                             GlyphSize="15"
                             ShowText="False" />
                <ui:UIButton Command="{Binding ReloadCommand}"
                             ShowText="False" />
                <ui:UIButton Command="{Binding CreateNewIssueCommand}"
                             ShowText="False" />
                <ui:UIButton Command="{Binding LoadOpenIssuesCommand}"
                             Glyph="kpi_status_open"
                             ShowText="False" />
                <ui:UIButton Command="{Binding LoadClosedIssuesCommand}"
                             Glyph="close_outline"
                             ShowText="False" />
            </StackPanel>

            <ListView Grid.Column="1"
                      HorizontalContentAlignment="Stretch"
                      Background="{DynamicResource ControlBackgroundBrush}"
                      Foreground="{DynamicResource ControlForegroundBrush}"
                      IsSynchronizedWithCurrentItem="True"
                      ItemTemplate="{StaticResource issueTemplate}"
                      ItemsSource="{Binding ColView}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.IsDeferredScrollingEnabled="True"
                      SelectedItem="{Binding SelectedIssueModel}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">

                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding EditIssueCommand}"
                                               CommandParameter="{Binding SelectedItem,
                                                                          RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListView>
        </Grid>
        <Separator Grid.Row="3"
                   Margin="0,5" />

        <Grid Grid.Row="4"
              Margin="0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto " />

            </Grid.ColumnDefinitions>
            <ui:TaggedTextBox IsNumericOnly="True"
                              TaggedText="Issues / Page"
                              TaggedWidth="100"
                              Text="{Binding FetchIssueCounts}"
                              ToolTip="Number of issues to show/fetch"
                              UpdateOnEnter="True" />
            <Grid Grid.Column="1"
                  HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>


                <ui:UIButton Command="{Binding LessPageCommand}"
                             ShowText="False" />
                <ui:TaggedTextBox Grid.Column="2"
                                  HorizontalContentAlignment="Center"
                                  IsNumericOnly="True"
                                  TaggedText="Page"
                                  TaggedWidth="50"
                                  Text="{Binding PageNumber}"
                                  UpdateOnEnter="True" />
                <ui:UIButton Grid.Column="4"
                             Command="{Binding MorePageCommand}"
                             ShowText="False" />

            </Grid>
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <!--<TextBlock Grid.Column="1">
                    <Run>Total:</Run>
                    <Run Text="{Binding TotalIssues}" />
                </TextBlock>-->
                <TextBlock Grid.Column="1">
                    <Run>Total Opened:</Run>
                    <Run Text="{Binding TotalOpened}" />
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</uc:SharpBIMUserControl>