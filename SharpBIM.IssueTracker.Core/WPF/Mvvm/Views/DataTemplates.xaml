<hl:SharedResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:Conv="clr-namespace:SharpBIM.WPF.Helpers.Converters;assembly=SharpBIM"
                             xmlns:hl="clr-namespace:SharpBIM.WPF.Utilities;assembly=SharpBIM"
                             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                             xmlns:mv="clr-namespace:SharpBIM.IssueTracker.Core.WPF.Mvvm.Models"
                             xmlns:mv1="clr-namespace:SharpBIM.IssueTracker.Core.WPF.Mvvm.Views"
                             xmlns:mvv="clr-namespace:SharpBIM.IssueTracker.Core.WPF.Mvvm.ViewModels"
                             xmlns:st="clr-namespace:SharpBIM.IssueTracker.Core.Enums"
                             xmlns:ui="clr-namespace:SharpBIM.WPF.Controls;assembly=SharpBIM">
    <hl:SharedResourceDictionary.MergedDictionaries>
        <hl:SharedResourceDictionary Source="/SharpBIM;component/WPF/AllControls.xaml" />
    </hl:SharedResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="AssigneeTemplate"
                  DataType="{x:Type mv:AssigneeModelView}">
        <Grid>
            <Ellipse Width="25"
                     Height="25"
                     Margin="2"
                     Fill="White"
                     Stroke="DarkMagenta"
                     StrokeThickness="2" />

            <Image Width="15"
                   Height="15"
                   Margin="2"
                   Cursor="Hand"
                   Source="{Binding AvatarPath}"
                   ToolTip="{Binding Title}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:InvokeCommandAction Command="{Binding ParentModelView.AssignMeCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Image>

        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="LabelDataTemplate"
                  DataType="{x:Type mv:LabelModelView}">
        <Border Margin="2"
                Padding="2"
                Background="{Binding BackgroundBrush,
                                     UpdateSourceTrigger=PropertyChanged}"
                CornerRadius="8"
                Cursor="Hand">

            <TextBlock Width="auto"
                       MinWidth="25"
                       Margin="1"
                       Padding="2"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="{Binding FontBrush,
                                            UpdateSourceTrigger=PropertyChanged}"
                       IsHitTestVisible="False"
                       Text="{Binding Title}"
                       TextAlignment="Center"
                       ToolTip="{Binding Hint}" />
            <Border.InputBindings>

                <MouseBinding Command="{Binding AddRemoveCommand}"
                              Gesture="LeftClick" />
            </Border.InputBindings>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="CommentTemplate"
                  DataType="{x:Type mv1:IssueCommentModelView}">
        <Grid Width="{Binding ActualWidth,
                              RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
              Margin="0,0,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="5" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.ColumnSpan="2"
                           HorizontalAlignment="Stretch"
                           VerticalContentAlignment="Center"
                           Background="{DynamicResource ControlDisabledBrush}">
                        <TextBlock HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Style="{DynamicResource DefaultTextBlockStyle}"
                                   Text="{Binding Title}" />
                    </Label>
                    <StackPanel Grid.Column="2">
                        <ui:UIButton Appearance="DontChangeTheme"
                                     Background="Transparent"
                                     Command="{Binding ShowOnWebCommand}"
                                     ShowText="False"
                                     Style="{DynamicResource IconButtonStyle}" />
                    </StackPanel>
                </Grid>

                <ui:MarkDownViewer x:Name="mk"
                                   Grid.Row="1"
                                   Markdown="{Binding MarkDown}" />
                <TextBlock Grid.Row="2"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Foreground="Gray"
                           TextAlignment="Right">
                    <Run>created:</Run>
                    <Run Text="{Binding CreatedDate}" />
                    <LineBreak />
                    <Run>modified:</Run>
                    <Run Text="{Binding ModifiedDate}" />
                </TextBlock>
                <Separator Grid.Row="3" />
            </Grid>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="issueTemplate"
                  DataType="{x:Type mvv:IssueViewModel}">
        <Border MinHeight="80"
                Background="Transparent"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="0,0,0,1">
            <Border.ContextMenu>
                <ui:UiContextMenu>
                    <ui:UiMenuItem Command="{Binding CopyTitleCommand}"
                                   Header="Copy Title" />
                </ui:UiContextMenu>
            </Border.ContextMenu>
            <Grid>
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="Collapsed" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Margin" Value="0,0,0,0" />
                            </MultiDataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="Visible" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Margin" Value="0,0,0,0" />
                            </MultiDataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsClosed}" Value="True" />
                                    <Condition Binding="{Binding DataContext.CurrentState, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="{x:Static st:IssueState.open}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Opacity=".3"
                                                         Color="DarkGreen" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Opacity" Value=".2" />
                            </MultiDataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsClosed}" Value="false" />
                                    <Condition Binding="{Binding DataContext.CurrentState, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="{x:Static st:IssueState.open}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Opacity="1"
                                                         Color="Transparent" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Opacity" Value="1" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="14"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap">
                            <Run Text="{Binding PreFix}" />
                            <Run Text="#" />
                            <Run Text="{Binding Id}" />
                            <Run Text="-" />
                            <Run Text="{Binding Title}" />
                        </TextBlock>
                        <Border Grid.Column="1"
                                Width="auto"
                                Height="auto    "
                                Margin="15,0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Visibility="{Binding TotalSubIssues,
                                                     Converter={Conv:ConvCountVisibility Min=0}}">
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding OpenSubIssueListCommand}"
                                              Gesture="LeftClick" />
                            </Border.InputBindings>
                            <Grid Cursor="Hand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <TextBlock HorizontalAlignment="Center"
                                           Background="Transparent"
                                           FontSize="9">
                                    <Run Text="{Binding Completed}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding TotalSubIssues}" />
                                </TextBlock>
                                <ProgressBar Grid.Row="1"
                                             Width="50"
                                             Height="5"
                                             Maximum="{Binding TotalSubIssues}"
                                             Value="{Binding Completed}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               MaxHeight="110"
                               Margin="0,0,5,0"
                               FontSize="11"
                               Foreground="{DynamicResource ControlBorderMidBrush}"
                               Text="{Binding Description}"
                               TextWrapping="Wrap" />
                </Grid>

                <WrapPanel Grid.Column="1"
                           MaxHeight="60"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           FlowDirection="RightToLeft"
                           Orientation="Vertical">

                    <ui:UIButton Background="Transparent"
                                 Command="{Binding ReloadIssueCommand}"
                                 ShowText="False" />
                    <ui:UIButton Background="Transparent"
                                 Command="{Binding ShowOnWebCommand}"
                                 ShowText="False"
                                 Style="{DynamicResource IconButtonStyle}" />
                    <ui:UIButton Background="Transparent"
                                 Command="{Binding CloseIssueCommand}"
                                 ShowText="False" />
                    <ui:UIButton Background="Transparent"
                                 Command="{Binding OpenCommentsCommand}"
                                 ShowText="False" />
                </WrapPanel>

                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      HorizontalAlignment="Right">

                    <StackPanel Orientation="Horizontal">
                        <ItemsControl VerticalAlignment="Bottom"
                                      ItemTemplate="{StaticResource LabelDataTemplate}"
                                      ItemsSource="{Binding IssueLabels}"
                                      Visibility="{Binding IssueLabels.Count,
                                                           Converter={Conv:ConvCountVisibility Min=0}}" />
                        <ui:UIButton VerticalAlignment="Bottom"
                                     Background="Transparent"
                                     Command="{Binding AssignMeCommand}"
                                     ShowText="False"
                                     Style="{DynamicResource IconButtonStyle}" />
                        <ItemsControl VerticalAlignment="Bottom"
                                      ItemTemplate="{StaticResource AssigneeTemplate}"
                                      ItemsSource="{Binding Assignees}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Width="auto"
                                                 Columns="2"
                                                 FlowDirection="RightToLeft" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
</hl:SharedResourceDictionary>