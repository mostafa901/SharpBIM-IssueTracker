<uc:SharpBIMUserControl x:Class="SharpBIM.IssueTracker.Core.WPF.Views.MainPage"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:Conv="clr-namespace:SharpBIM.WPF.Helpers.Converters;assembly=SharpBIM"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:hl="clr-namespace:SharpBIM.WPF.Utilities;assembly=SharpBIM"
                        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:mv="clr-namespace:SharpBIM.IssueTracker.Core.WPF.Views"
                        xmlns:uc="clr-namespace:SharpBIM.WPF.Controls.UserControls;assembly=SharpBIM"
                        xmlns:ui="clr-namespace:SharpBIM.WPF.Controls;assembly=SharpBIM"
                        d:DataContext="{d:DesignInstance Type={x:Type mv:MainPageViewModel}}"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        mc:Ignorable="d">

    <Grid>
        <Grid.Resources>
            <hl:SharedResourceDictionary>

                <hl:SharedResourceDictionary.MergedDictionaries>
                    <hl:SharedResourceDictionary SamoDesign="True"
                                                 Source="/SharpBIM;component/WPF/AllControls.xaml" />

                    <hl:SharedResourceDictionary SamoDesign="True"
                                                 Source="/SharpBIM.IssueTracker.Core;component/WPF/Mvvm/Views/DataTemplates.xaml" />
                </hl:SharedResourceDictionary.MergedDictionaries>

            </hl:SharedResourceDictionary>
        </Grid.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <ui:UIButton Command="{Binding ShowLoginScreenCommand}"
                                 GlyphSize="20"
                                 ShowText="False"
                                 Visibility="{Binding IsLoginScreen,
                                                      Converter={Conv:ConvBoolToVisibility Inverse=True}}" />
                    <ui:UIButton Grid.Column="1"
                                 Command="{Binding FeedBackCommand}"
                                 GlyphSize="20"
                                 ShowText="False"
                                 Visibility="{Binding IsLoginScreen,
                                                      Converter={Conv:ConvBoolToVisibility Inverse=True}}" />
                    <ui:UIButton Grid.Column="2"
                                 Command="{Binding StarRepoCommand}"
                                 GlyphSize="20"
                                 ShowText="False"
                                 Visibility="{Binding StarRepoCommand.IsVisible,
                                                      Converter={Conv:ConvBoolToVisibility}}" />
                </Grid>
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">

                    <ui:UIButton Command="{Binding NavigateBackCommand}"
                                 CommandParameter="{Binding ElementName=SharpBIMViewer}"
                                 Glyph="arrow_60_left"
                                 GlyphSize="25"
                                 IsEnabled="{Binding CanGoBack,
                                                     ElementName=SharpBIMViewer}"
                                 ShowText="False" />
                    <TextBlock MinWidth="150"
                               Text="{Binding Content.Content.DataContext.Title,
                                              ElementName=SharpBIMViewer}"
                               TextAlignment="Center" />
                    <ui:UIButton Command="{Binding NavigateForwardCommand}"
                                 CommandParameter="{Binding ElementName=SharpBIMViewer}"
                                 Glyph="arrow_60_right"
                                 GlyphSize="25"
                                 IsEnabled="{Binding CanGoForward,
                                                     ElementName=SharpBIMViewer}"
                                 ShowText="False" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right"
                                   Cursor="Hand"
                                   Foreground="{DynamicResource ControlDisabledBrush}"
                                   ToolTip="Check for updates">
                            <Run Text="Ver." />
                            <Run Text="{Binding Version}" />
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding CheckForUpdatesCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBlock>
                        <ProgressBar IsIndeterminate="True"
                                     Visibility="{Binding IsCheckingForUpdate,
                                                          Converter={Conv:ConvBoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right"
                               Visibility="{Binding NewVersionLink,
                                                    Converter={Conv:ConvNullVisibility Invert=False}}">
                        <Hyperlink Command="{Binding VisitMarketPlaceCommand}"
                                   NavigateUri="{Binding NewVersionLink}">
                            <Run Text="{Binding DownloadMessage}" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Frame x:Name="SharpBIMViewer"
                   Grid.Row="1"
                   JournalOwnership="OwnsJournal"
                   NavigationUIVisibility="Hidden" />
        </Grid>
        <Grid Visibility="{Binding CurrentView, Converter={Conv:ConvNullVisibility}}">
            <Rectangle Fill="{DynamicResource ControlBackground}">
                <Rectangle.Effect>
                    <BlurEffect Radius="25" />
                </Rectangle.Effect>
            </Rectangle>
            <ContentControl HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            Content="{Binding CurrentView}" />
        </Grid>
        <Border MinWidth="100"
                Padding="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource ControlBackground}"
                CornerRadius="15"
                Visibility="{Binding ShowProgressBar,
                                     Converter={Conv:ConvBoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="prgBarTxt"
                           Margin="0,5"
                           HorizontalAlignment="Center"
                           Text="{Binding ProgressMessage,
                                          UpdateSourceTrigger=PropertyChanged}"
                           TextWrapping="Wrap" />
                <ProgressBar x:Name="prgBar"
                             Grid.Row="1"
                             Width="100"
                             MinHeight="5"
                             Foreground="{DynamicResource ControlBlueThemeBrush}"
                             IsIndeterminate="False" />
            </Grid>
        </Border>


        <Grid Visibility="{Binding ProgressActivity.IsVisible, Converter={Conv:ConvBoolToVisibility}}">
            <ui:SharpProgressView HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  DataContext="{Binding ProgressActivity}" />
        </Grid>

    </Grid>
</uc:SharpBIMUserControl>