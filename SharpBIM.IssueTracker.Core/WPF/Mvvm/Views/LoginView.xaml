<uc:SharpBIMUserControl x:Class="SharpBIM.IssueTracker.Core.WPF.Mvvm.Views.LoginView"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:Conv="clr-namespace:SharpBIM.WPF.Helpers.Converters;assembly=SharpBIM"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:hl="clr-namespace:SharpBIM.WPF.Utilities;assembly=SharpBIM"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:mv="clr-namespace:SharpBIM.IssueTracker.Core.WPF.Mvvm.ViewModels"
                        xmlns:st="clr-namespace:SharpBIM.IssueTracker.Core"
                        xmlns:uc="clr-namespace:SharpBIM.WPF.Controls.UserControls;assembly=SharpBIM"
                        xmlns:ui="clr-namespace:SharpBIM.WPF.Controls;assembly=SharpBIM"
                        d:DataContext="{d:DesignInstance Type={x:Type mv:LoginViewModel}}"
                        d:DesignHeight="450"
                        d:DesignWidth="200"
                        Background="{DynamicResource ControlBackground}"
                        mc:Ignorable="d">
    <Grid Margin="50"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Center">
        <Grid.Resources>
            <hl:SharedResourceDictionary>

                <hl:SharedResourceDictionary.MergedDictionaries>
                    <hl:SharedResourceDictionary SamoDesign="True"
                                                 Source="/SharpBIM;component/WPF/AllControls.xaml" />

                    <hl:SharedResourceDictionary SamoDesign="True"
                                                 Source="/SharpBIM.IssueTracker.Core;component/WPF/Mvvm/Views/DataTemplates.xaml" />
                </hl:SharedResourceDictionary.MergedDictionaries>

            </hl:SharedResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Image HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Source="/SharpBIM.IssueTracker.Core;component/Resources/tickets_Login.png" />
        <Grid Grid.Row="1"
              Margin="0,20,0,0"
              VerticalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,10"
                           HorizontalAlignment="Center"
                           Background="Transparent"
                           FontSize="14"
                           Foreground="{DynamicResource ControlFontBrush}"
                           Text="Type your personal token, or Authorize Issue Tracker"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Row="1">
                    <Border Margin="0,0,0,10"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <PasswordBox x:Name="pasBox"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="{DynamicResource ControlBackground}"
                                     BorderThickness="0"
                                     FontSize="18"
                                     FontStretch="UltraExpanded"
                                     Foreground="{DynamicResource ControlFontBrush}"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     PasswordChar="x" />
                    </Border>
                    <Grid Margin="20,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Top"
                                   Text="ℹ " />
                        <TextBlock Grid.Column="1"
                                   Foreground="{StaticResource ControlFontDisabledBrush}">
                            <Run>To avoid entering your secret key every time, it can be stored as the environment variable '</Run>
                            <Run Text="{x:Static st:Statics.ISSUETRACKERKEY}" />
                            <Run>'</Run>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2"
                  HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ui:UIButton HorizontalAlignment="Stretch"
                             Appearance="Primary"
                             Command="{Binding AuthorizeCommand}"
                             ShowIcon="False" />

                <ui:UIButton Grid.Column="1"
                             Margin="10,0,0,0"
                             HorizontalAlignment="Stretch"
                             Appearance="Secondary"
                             Command="{Binding CancelCommand}"
                             ShowIcon="False"
                             Visibility="{Binding AlreadyLoggedIn,
                                                  Converter={Conv:ConvBoolToVisibility}}" />
            </Grid>
        </Grid>
    </Grid>
</uc:SharpBIMUserControl>