<Solution>
  <Configurations>
    <BuildType Name="DNoWin" />
    <BuildType Name="DWin" />
    <BuildType Name="RNoWin" />
    <BuildType Name="RWin" />
    <BuildType Name="SA" />
  </Configurations>
   <Platforms>
    <Platform Name="x64" />
  </Platforms>
  <Folder Name="/SolutionItems/">
    <File Path="BuildAll.ps1" />
    <File Path="BuildAll_VSAddin.ps1" />
    <File Path="SolutionItems/SharpBIM.Defaults.props" />
    <File Path="SolutionItems/SharpBIM.Identity.props" />
  </Folder>
  <Project Path="../../SharpBIM/src/SharpBIM.csproj">
    <BuildType Solution="SA|*" Project="DWin" />
  </Project>
  <Project Path="SharpBIM.IssueTracker.Console/SharpBIM.IssueTracker.Console.csproj">
    <BuildType Solution="DNoWin|*" Project="Debug" />
    <BuildType Solution="DWin|*" Project="Debug" />
    <BuildType Solution="RNoWin|*" Project="Release" />
    <BuildType Solution="RWin|*" Project="Release" />
    <BuildType Solution="SA|*" Project="Debug" />
    <Build Solution="DWin|*" Project="false" />
    <Build Solution="RWin|*" Project="false" />
    <Build Solution="SA|*" Project="false" />
  </Project>
  <Project Path="SharpBIM.IssueTracker.Core/SharpBIM.IssueTracker.Core.csproj" />
  <Project Path="SharpBIM.IssueTracker/SharpBIM.IssueTracker.csproj">
    <BuildType Solution="DNoWin|*" Project="RWin" />
    <BuildType Solution="RNoWin|*" Project="DWin" />
    <BuildType Solution="SA|*" Project="DWin" />
    <Platform Project="x64" />
    <Deploy Solution="DWin|*" />
  </Project>
 
</Solution>
