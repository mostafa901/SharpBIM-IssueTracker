<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\SolutionItems\SharpBIM.Identity.props" />
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <Configurations>DWin;RWin;DNoWin;RNoWin</Configurations>
       
        <LangVersion>latest</LangVersion>
        <UserSecretsId>b2fcdead-28ce-41dd-9cf5-ec9e67c5f44e</UserSecretsId>
        <AssemblyVersion>0.821.3.0</AssemblyVersion>
    </PropertyGroup>
    <PropertyGroup Condition="(('$(Configuration)' == 'DWin' Or '$(Configuration)' == 'RWin'))">
        <TargetFrameworks>net47;net472;net48;net8.0-windows8;net10.0-windows8</TargetFrameworks>
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Configuration)' == 'DNoWin' Or '$(Configuration)' == 'RNoWin')">
        <TargetFrameworks>net47;net472;net48;net8.0</TargetFrameworks>
        <DefineConstants>$(DefineConstants);WEB</DefineConstants>
    </PropertyGroup>
	<PropertyGroup Condition="$(TargetFramework.startswith('net8'))">
		<DefineConstants>$(DefineConstants);DOTNET8;DOTNET</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$(TargetFramework.startswith('net10'))">
		<DefineConstants>$(DefineConstants);DOTNET10;DOTNET</DefineConstants>
	</PropertyGroup>
	<!-- Configuration-specific settings -->
    <PropertyGroup Condition="$(Configuration.StartsWith('D'))">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.StartsWith('R'))">
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="WPF\Mvvm\Views\LableSelectionView.xaml.cs" />
        <Compile Remove="WPF\Mvvm\Views\SharpColorPicker.xaml.cs" />
    </ItemGroup>
    <ItemGroup>
        <None Remove="C:\Users\MoustafaElsayed\.nuget\packages\microsoft.vssdk.buildtools\17.12.2069\contentFiles\any\net472\msalruntime.dll" />
        <None Remove="C:\Users\MoustafaElsayed\.nuget\packages\microsoft.vssdk.buildtools\17.12.2069\contentFiles\any\net472\msalruntime_arm64.dll" />
        <None Remove="C:\Users\MoustafaElsayed\.nuget\packages\microsoft.vssdk.buildtools\17.12.2069\contentFiles\any\net472\msalruntime_x86.dll" />
        <None Remove="Resources\tickets_Login.png" />
    </ItemGroup>
    <ItemGroup>
        <Page Remove="WPF\Helpers\Markdown.Style.xaml" />
        <Page Remove="WPF\Mvvm\Views\LableSelectionView.xaml" />
        <Page Remove="WPF\Mvvm\Views\SharpColorPicker.xaml" />
    </ItemGroup>
    <ItemGroup Condition="!($(DefineConstants.Contains('WINDOWS')))">
        <Compile Remove="WPF\**" />
        <EmbeddedResource Remove="WPF\**" />
        <None Remove="WPF\**" />
        <Page Remove="WPF\**" />
    </ItemGroup>
    <ItemGroup Condition="($(DefineConstants.Contains('WINDOWS')))">
        <PackageReference Include="HtmlAgilityPack">
            <Version>1.12.0</Version>
        </PackageReference>
        <PackageReference Include="MdXaml">
            <Version>2.0.0-pre202603081301</Version>
        </PackageReference>
    </ItemGroup>
    
    <ItemGroup>
        <Resource Include="Resources\tickets_Login.png" />
    </ItemGroup>
    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Exec Command="rem call xcopy $(MSBuildProjectDirectory)\$(OutputPath)*.* $(MSBuildProjectDirectory)\..\SharpBIM.GitTracker\GitPublish\* /s /y" />
    </Target>
    <ItemGroup>
        <Compile Remove="GitHttp\Models\**" />
        <EmbeddedResource Remove="GitHttp\Models\**" />
        <None Remove="GitHttp\Models\**" />
        <VSCTInclude Remove="WPF\Mvvm\Views\Views\**" />
    </ItemGroup>
    <PropertyGroup>
        <UseBimPack>false</UseBimPack>
    </PropertyGroup>
 
 
    <ItemGroup Condition="!$(UseBimPack)">
        <!--<Reference Include="SharpBIM">
            <HintPath>..\..\..\SharpBIM\Publish\$(Configuration)\$(TargetFramework)\SharpBIM.dll</HintPath>
        </Reference>-->
      <ProjectReference Include="..\..\..\SharpBIM\src\SharpBIM.csproj" />
		
        <PackageReference Include="Auth0.OidcClient.WPF" Version="4.1.0" />
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0-beta.98" />
        <PackageReference Include="envdte100" Version="17.12.40391" />
        <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.5.0" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.5.0" />
        <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
        <PackageReference Include="Microsoft.VisualStudio.Utilities" Version="17.12.40391" />
        <PackageReference Include="System.Net.Http" Version="4.3.4" />
        <Reference Include="System.Web" Condition="!$(DefineConstants.Contains('DOTNET'))" />
    </ItemGroup>
 
    <ItemGroup>
      <Compile Include="GitHttp\Models\User.cs" />
    </ItemGroup>
 
    <ItemGroup>
      <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    </ItemGroup>
 
	<!--<ItemGroup Condition="$(Configuration.StartsWith('D'))">
		<ProjectReference Include="..\..\..\SharpBIM\src\SharpBIM.csproj" />
	</ItemGroup>-->
 
 
    <ItemGroup>
      <None Update="appsettings.local.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>
</Project>
